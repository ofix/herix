{
    "name": "herix",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "src/main/bootstrap.js",
    "workspaces": [
        "src/libs/*",
        "src/workers/*"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "check": "tsc --noEmit",
        "lint": "eslint . --max-warnings=0",
        "test": "vitest run",
        "ui:dev": "vite --config src/ui/vite.config.js",
        "main:dev": "wait-on http://localhost:5178 && VITE_DEV_SERVER_URL=http://localhost:5178 electron .",
        "dev": "concurrently -k \"npm:ui:dev\" \"npm:main:dev\"",
        "gen:skeleton": "node scripts/gen-skeleton.mjs",
        "gen:surface": "node scripts/gen-api-surface.mjs --root src --progress doc/progress.json --out doc/api-surface.md",
        "gate": "npm run check && npm run lint && npm run test",
        "ui:build": "vite build --config src/ui/vite.config.js"
    },
    "dependencies": {
        "playwright-core": "^1.65.1",
        "yaml": "^2.9.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^5.2.4",
        "concurrently": "^10.0.7",
        "electron": "^33.4.11",
        "element-plus": "^2.14.8",
        "eslint": "^9.13.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jsdoc": "^50.4.3",
        "fast-check": "^3.22.0",
        "monaco-editor": "^0.52.2",
        "splitpanes": "^3.2.0",
        "typescript": "^5.6.3",
        "vite": "^5.4.21",
        "vitest": "^2.1.3",
        "vue": "^3.5.46",
        "vue-virtual-scroller": "^2.0.1",
        "wait-on": "^9.5.1"
    },
    "_note": "electron / playwright-core / vue 等按批次追加（B2 起），见 doc/progress.json"
}
